public class DecimalToBinary {
    public static void decToBin(int decNum) {
        int binNum = 0, pow = 0;
        while (decNum > 0) {
            int rem = decNum % 2;
            binNum = binNum + rem * ((int) Math.pow(10, pow++));
            decNum /= 2;
        }
        System.out.println(binNum);
    }

    public static void main(String[] args) {
        decToBin(8900);
    }
}
